class Solution {
    public int maximumGap(int[] nums) {
        Arrays.sort(nums);
        int maximumgap = 0;
        int n = nums.length;
        if(n==1){
            return 0;
        }
        for(int i =1; i<n; i++){
         maximumgap = Math.max(maximumgap , nums[i]-nums[i-1]);
        }
        return maximumgap;
    }
}
