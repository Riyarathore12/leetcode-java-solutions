class Solution {
    public int findNthDigit(int n) {
        long digitlength = 1;
        long count = 9;
        long start = 1;

        while(n >digitlength*count){
            n -= digitlength *count;
            digitlength++;
            count*=10;
            start *= 10;

        }
        long number = start+(n-1)/digitlength;
        int index = (int)((n-1)%digitlength);
        return String.valueOf(number).charAt(index)-'0';
    }
}
